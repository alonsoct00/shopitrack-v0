# Analytics — IDs públicos (no secretos). Vacío = servicio inactivo.
# En producción se configuran en Vercel → Settings → Environment Variables.
# Detalle en docs/ANALYTICS.md. Nunca pongas secretos en variables VITE_*.

# LinkedIn Insight Tag (Partner ID)
VITE_LINKEDIN_PARTNER_ID=

# Google Tag Manager (GTM-XXXXXXX) — preparado, inactivo
VITE_GTM_ID=

# Google Analytics 4 (G-XXXXXXXXXX) — preparado, inactivo
VITE_GA4_MEASUREMENT_ID=
